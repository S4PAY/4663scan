# ── RPC endpoints (ordered by preference; all keyless except QUINARY) ──
RPC_HTTP_PRIMARY=https://rpc.arrowrpc.com
RPC_HTTP_FALLBACK=https://rpc.mainnet.chain.robinhood.com
# Independent providers beyond the two above — added 2026-07-22 after
# ArrowRPC's primary got stuck for 2+ hours and relying on one fallback
# alone capped recovery well below real-time. All optional; head.ts's
# fallback pool AND the shared client used by backfill both rotate across
# whichever of these are set (packages/shared/src/chain.ts fallbackUrls()).
# (dRPC's own hosted endpoint for chain 4663 is paid-tier only as of
# 2026-07, so not used here.)
RPC_HTTP_TERTIARY=https://robinhood-rpc.publicnode.com
RPC_HTTP_QUATERNARY=https://robinhood-chain.gateway.tenderly.co
# Validation Cloud — REPLACE ME with your own key (validationcloud.io,
# free tier or pay-as-you-go). Never commit a real key here; this file is
# the example only. See docs/ops.md for how this was verified/measured.
RPC_HTTP_QUINARY=https://mainnet.robinhood.validationcloud.io/v1/REPLACE_ME
# Keyless WSS (verified working) for newHeads subscription
RPC_WSS=wss://ws.arrowrpc.com
CHAIN_ID=4663

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://fourscan:fourscan@127.0.0.1:54663/fourscan
# false = system Postgres (production): scripts/db.mjs start/stop are no-ops.
DB_EMBEDDED=true
# Postgres data dir (embedded mode only). MUST be on a native Linux
# filesystem (not /mnt/*). Defaults to ~/.local/share/4663scan/pgdata.
PGDATA_DIR=
PGPORT=54663

# ── Indexer ───────────────────────────────────────────────────────────
# Hard global cap on RPC requests/second across head-following + backfill.
INDEXER_MAX_RPS=60
# Blocks at least this deep are treated as immutable (cache + reorg-safe).
# ~17 min at 100ms blocks: covers the blob-batch posting interval (~24-48s)
# plus Ethereum finality (~13 min) with margin.
CONFIRM_DEPTH=10000
# Max reorg depth the indexer will attempt to recover from automatically.
REORG_LIMIT=512
BACKFILL_ENABLED=true
# Blocks fetched per backfill batch.
BACKFILL_CHUNK=16

# ── Storage tiering (docs/architecture.md) ────────────────────────────
# Full detail (calldata, logs, all transfers) is kept this long; older txs
# demote to slim rows, logs partitions drop, non-stock transfers prune.
HOT_WINDOW_SECONDS=604800
RETENTION_ENABLED=true
RETENTION_INTERVAL_SECONDS=900
# Block-range width of one demotion UPDATE transaction.
RETENTION_BATCH_BLOCKS=20000

# ── API ───────────────────────────────────────────────────────────────
API_PORT=4663
API_HOST=0.0.0.0

# ── Web ───────────────────────────────────────────────────────────────
# URL the browser uses to reach the API (SSE, client fetches)
NEXT_PUBLIC_API_URL=http://localhost:4663
# URL the Next.js server uses to reach the API (SSR)
API_URL=http://localhost:4663

# ── Paid token submissions (M8) ─────────────────────────────────────────
# REPLACE ME: a real wallet address you control. Left as this obvious
# placeholder, submissions stay disabled (503) rather than accepting
# payment toward an address nobody actually holds.
TREASURY_ADDRESS=0x1111111111111111111111111111111111111111
SUBMISSION_PRICE_USD=99
# USDG (Global Dollar) — confirmed 2026-07 as chain 4663's own native, liquid
# USD stablecoin. Change only if the operator wants to accept a different
# asset; also update PAYMENT_TOKEN_SYMBOL/DECIMALS to match.
PAYMENT_TOKEN_ADDRESS=0x5fc5360d0400a0fd4f2af552add042d716f1d168
PAYMENT_TOKEN_SYMBOL=USDG
PAYMENT_TOKEN_DECIMALS=6
PAYMENT_QUOTE_WINDOW_HOURS=24
PAYMENT_MAX_TX_AGE_SECONDS=86400
